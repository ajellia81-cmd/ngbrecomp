if(NOT APPLE OR CMAKE_SYSTEM_NAME STREQUAL "iOS")
    message(FATAL_ERROR "Build the game for macOS first; iPhoneOS is only for compatibility shims")
endif()
enable_language(OBJC)
set(NGB_CONVERSION_DIR "${CMAKE_CURRENT_SOURCE_DIR}/porting/macos-on-ios")
target_sources(${PROJECT_NAME} PRIVATE "${NGB_CONVERSION_DIR}/bootstrap.m" "${NGB_CONVERSION_DIR}/dsp_mailbox.c" "${NGB_CONVERSION_DIR}/korean/korean.m")
target_sources(ngb_gen PRIVATE "${NGB_CONVERSION_DIR}/korean/game_hooks.c" "${NGB_CONVERSION_DIR}/korean/korean_text_layout.c")
foreach(t ${PROJECT_NAME} ngb_gen)
    target_compile_definitions(${t} PRIVATE NGB_IOS_KOREAN=1 NGB_CONVERTED_DISPLAY=1)
    target_include_directories(${t} PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src" "${NGB_CONVERSION_DIR}" "${NGB_CONVERSION_DIR}/korean")
endforeach()
target_compile_options(${PROJECT_NAME} PRIVATE $<$<COMPILE_LANGUAGE:OBJC>:-fobjc-arc>)
target_link_libraries(${PROJECT_NAME} PRIVATE "-framework Foundation" "-framework AppKit" "-framework ImageIO" "-framework CoreGraphics")

if(TARGET xbox_nv2a_vk)
    target_compile_definitions(xbox_nv2a_vk PRIVATE NGB_CONVERTED_DISPLAY=1)
    target_include_directories(xbox_nv2a_vk PRIVATE "${NGB_CONVERSION_DIR}")
endif()

# The game is still built for macOS. Only scene replay and the display bridge
# opt into Smooth Motion; the CPU scheduler and shader compiler stay unchanged.
if(TARGET ngb_d3d)
    target_compile_definitions(ngb_d3d PRIVATE NGB_SMOOTH_MOTION=1 NGB_CONVERTED_DISPLAY=1)
    target_sources(ngb_d3d PRIVATE src/d3d/gpu/scene_motion.cpp third_party/vf3_scene/interpolate.cpp)
    set_source_files_properties(src/d3d/gpu/scene_motion.cpp PROPERTIES COMPILE_OPTIONS "-ffp-contract=off")
endif()
